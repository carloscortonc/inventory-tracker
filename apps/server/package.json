{
  "name": "@inventory-tracker/server",
  "version": "1.0.0",
  "type": "module",
  "main": "index.js",
  "license": "MIT",
  "scripts": {
    "start": "PORT=8080 nodemon --watch src --watch ../scanner/src -e ts --exec tsx src/index.ts",
    "build": "rimraf dist && bun scripts/build.js && copyfiles package*.json .env Dockerfile dist",
    "deploy": "npm run build && rpi deploy dist --name server --vars PORT=8443 --build-on-target --envfile .env"
  },
  "dependencies": {
    "@koa/bodyparser": "^5.1.1",
    "@koa/cors": "^5.0.0",
    "@koa/router": "^12.0.1",
    "dotenv": "^16.4.5",
    "fast-redact": "^3.5.0",
    "js-sha256": "^0.11.0",
    "jsdom": "^24.0.0",
    "jsonwebtoken": "^9.0.2",
    "koa": "^2.15.3",
    "koa-bodyparser": "^4.4.1",
    "koa-cookies": "^4.0.2",
    "lodash.omit": "^4.5.0",
    "mailgen": "^2.0.29",
    "mongoose": "^8.4.0",
    "ms": "^2.1.3",
    "nodemailer": "^7.0.6",
    "reflect-metadata": "^0.2.2"
  },
  "devDependencies": {
    "@types/fast-redact": "^3.0.4",
    "@types/jsdom": "^21.1.6",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/koa": "^2.15.0",
    "@types/koa__router": "^12.0.4",
    "@types/koa-bodyparser": "^4.3.12",
    "@types/lodash.omit": "^4.5.9",
    "@types/nodemailer": "^7.0.1",
    "bun-types": "^1.2.22",
    "copyfiles": "^2.4.1",
    "nodemon": "^3.1.0",
    "rimraf": "^6.0.1",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.8.10",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.10.5",
    "typescript": "^5.4.5"
  }
}
