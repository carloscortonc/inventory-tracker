{
  "name": "inventory-tracker",
  "version": "0.1.0",
  "private": "true",
  "description": "Application to keep track of inventory of any kind, using barcodes as item identifiers",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "build": "turbo run build",
    "package": "turbo run package",
    "deploy": "npm run deploy:prepare turbo run deploy",
    "deploy:prepare": "node scripts/pass-gen.js && dotenv --",
    "start": "turbo start"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/carloscortonc/inventory-tracker.git"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "packageManager": "npm@10.5.2",
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/carloscortonc/inventory-tracker/issues"
  },
  "homepage": "https://github.com/carloscortonc/inventory-tracker#readme",
  "devDependencies": {
    "dotenv-cli": "^7.4.2",
    "generate-password": "^1.7.1",
    "turbo": "^2.0.9"
  }
}
